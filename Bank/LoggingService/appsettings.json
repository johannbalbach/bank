{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "System": "Warning"
      }
    }
  },
  "RedisOptions": {
    "Configuration": "redis:6379"
  },
  "Redis": {
    "BatchSize": 100
  },
  "LogConfig": {
    "Uri": "http://elasticsearch:9200"
  }
}
